{
  "name": "product-api",
  "version": "1.0.0",
  "description": "Serverless backend for product UI using CloudFormation",
  "main": "index.js",
  "scripts": {
    "deploy": "scripts/deploy.sh",
    "deploy:dev": "scripts/deploy.sh --stage dev",
    "deploy:prod": "scripts/deploy.sh --stage prod",
    "deploy:full": "scripts/deploy-full.sh",
    "deploy:full:dev": "scripts/deploy-full.sh --stage dev",
    "deploy:full:prod": "scripts/deploy-full.sh --stage prod",
    "cleanup": "scripts/cleanup.sh",
    "cleanup:all": "scripts/cleanup.sh --empty-bucket",
    "initialize-s3": "node scripts/init-s3.js",
    "start": "node local-server.js",
    "dev": "nodemon local-server.js",
    "package": "sam package --template-file template.yaml --output-template-file packaged.yaml --s3-bucket $S3_BUCKET",
    "local:api": "sam local start-api"
  },
  "dependencies": {
    "aws-sdk": "^2.1429.0",
    "uuid": "^9.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2"
  },
  "devDependencies": {
    "serverless": "^3.34.0",
    "nodemon": "^3.0.1",
    "aws-sam-cli": "^1.68.0"
  }
} 